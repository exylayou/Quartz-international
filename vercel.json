{
  "redirects": [
    {
      "source": "/kitchen-cabinets",
      "destination": "/cabinets",
      "permanent": true
    },
    {
      "source": "/quartz-countertops-kasa",
      "destination": "/kasa-quartz",
      "permanent": true
    },
    {
      "source": "/quartz-countertops-kstone",
      "destination": "/kstone",
      "permanent": true
    },
    {
      "source": "/quartz-countertops-lucent",
      "destination": "/lucent-quartz",
      "permanent": true
    },
    {
      "source": "/quartz-countertops-tce",
      "destination": "/tce-stone",
      "permanent": true
    },
    {
      "source": "/quartz-vs-quartzite",
      "destination": "/quartz-vs-quartzite-countertops-toronto",
      "permanent": true
    },
    {
      "source": "/quartz-countertop-cost/:path*",
      "destination": "/cost",
      "permanent": true
    },
    {
      "source": "/kitchen-cabinets/:path*",
      "destination": "/cabinets",
      "permanent": true
    },
    {
      "source": "/quartz-countertops-:city",
      "destination": "/:city",
      "permanent": true
    },
    {
      "source": "/kitchen-cabinets-:city",
      "destination": "/:city",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/app-shell.html"
    },
    {
      "source": "/results",
      "destination": "/app-shell.html"
    },
    {
      "source": "/quote/:path*",
      "destination": "/app-shell.html"
    }
  ],
  "env": {
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  },
  "functions": {
    "api/index.ts": {
      "includeFiles": "seeds/*",
      "excludeFiles": "{dist/**,.ssg/**,src/assets/**,slabs/**,scratch/**,public/**,backup_temp/**,docs/**,local-server.ts,*.zip,*.mhtml}",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/app-shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/results",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/quote/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
